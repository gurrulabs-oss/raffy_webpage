<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace REPO_PATH and HOME_PATH, then install per docs/analytics.md#weekly-run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.raffyparenting.analytics-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/scripts/analytics/weekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>HOME_PATH/Library/Logs/raffy-analytics.log</string>
  <key>StandardErrorPath</key><string>HOME_PATH/Library/Logs/raffy-analytics.log</string>
</dict>
</plist>
